{
    "name": "drupal-nix-tools/php-toolbox",
    "description": "Pinned PHP QA toolchain mirroring Drupal core CI validate jobs. Resolution is pinned to PHP 8.3 (Drupal 11's minimum) so the same lock runs unchanged on 8.3, 8.4 and 8.5.",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "drupal/coder": "^8.3.30",
        "mglaman/phpstan-drupal": "^2.0.15",
        "micheh/phpcs-gitlab": "^2.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "squizlabs/php_codesniffer": "^3.13",
        "vincentlanglet/twig-cs-fixer": "^3.10"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
